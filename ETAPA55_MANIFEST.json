  "relationship": {
    "directional": true,
    "type": "opaque RelationshipTypeId",
    "strengthRange": "-100..100",
    "selfRelationship": "rejected"
  },
  "rules": [
    "No relation symmetry is inferred.",
    "FactionRelation and Reputation are distinct concepts.",
    "No concrete Agent/WorldObject dependency.",
    "No Conditions/Dialogue/AI cross-domain integration before Stage 62.",
    "No Economy Stage 56 files are anticipated.",
    "Compatible with 2D, 2.5D, 3D and headless execution."
