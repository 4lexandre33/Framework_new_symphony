  "rules": {
    "damage": [
      "flat mitigation precedes multiplier",
      "effective damage is clamped by available health",
      "already defeated target is rejected",
      "no Agent mutation"
    ],
    "healing": [
      "healing is clamped by missing health",
      "defeated target is rejected instead of revived",
      "no Agent mutation"
    ],
    "movementTraversal": [
      "endpoints and movement modes are opaque semantic IDs",
      "same endpoint intent is rejected",
      "traversal checks allowed modes and required capabilities",
      "no pathfinding or physical movement"
    ],
    "requirements": [
      "all/any modes",
      "all declared requirements must have resolutions",
      "unknown resolutions are structural errors",
      "resolution source remains external"
    ]
  },
  "explicitlyDeferred": [
    "DamageRule -> Agent integration",
