{
  "schemaVersion": 1,
  "stage": 88,
  "stageName": "Desktop / Steam Production Readiness",
  "baselineId": "layer1-desktop-production-v1-stage88",
  "referenceStage": 87,
  "desktop": {
    "productName": "projeto1",
    "identifier": "com.projeto1.game",
    "version": "0.1.0",
    "frontendDist": "../dist",
    "releaseBundle": "NSIS",
    "window": {
      "width": 1280,
      "height": 720,
      "resizable": true,
      "transparent": true,
      "decorations": false,
      "alwaysOnTop": true
    },
    "cspRequired": true,
    "globalTauriDisabled": true
  },
  "steam": {
    "devAppId": "480",
    "devAppIdSource": "src-tauri/steam_appid.txt",
    "devAppIdBundled": false,
    "defaultCargoFeature": "steam",
    "hardcodedSteamAppIdEnvironmentForbidden": true,
    "releaseShutdown": "Tauri RunEvent::Exit -> SteamState.shutdown"
  },
  "lifecycle": {
    "devicePixelRatioCapped": 2,
    "resizeListenerReleased": true,
    "blurRecovery": true,
    "visibilityRecovery": true,
    "pointerLockRecovery": true
  },
  "certification": {
    "linuxRunner": "ubuntu-latest",
    "windowsRunner": "windows-latest",
    "rustToolchain": "1.97.0",
    "cargoBuildJobs": 1,
    "vitestFileParallelism": false,
    "linuxReleaseNoBundle": true,
    "windowsNsisRealBundle": true,
    "cargoManifestMutationForbidden": true,
    "preserveCargoManifestBytes": true,
    "tauriCliManifestNormalizationIsRestored": true,
    "immutableRevision": true,
    "crossRunnerEvidenceHandoff": "GitHub Actions artifact",
    "cancelStaleRuns": true,
    "crossPlatformLineEndingAudit": true
  },
  "knownToolchainExclusions": {
    "1.99.0": "local investigation reproduced internal compiler SIGSEGV/SIGBUS outside the project",
    "1.98.1": "local investigation reproduced a separate compiler ICE"
  }
}
